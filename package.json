{
  "name": "@lengend-nightmare/engine",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "A platform-neutral TypeScript engine for deterministic monster arena games.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/acccount1982-star/engine.git"
  },
  "bugs": {
    "url": "https://github.com/acccount1982-star/engine/issues"
  },
  "homepage": "https://lengendnightmare.dev/engine",
  "keywords": [
    "game-engine",
    "typescript",
    "deterministic",
    "turn-based",
    "real-time"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepack": "pnpm run build",
    "pack:release": "node scripts/pack-release.mjs",
    "release:prepare": "pnpm run typecheck && pnpm test && pnpm run pack:release && node scripts/prepare-release.mjs",
    "release:check": "node scripts/prepare-release.mjs --check",
    "release:publish": "pnpm run release:prepare && node scripts/publish-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}